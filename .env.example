# Run pnpm setup:local to create private, unique credentials in the ignored .env file.
DATABASE_URL=
ATLAS_TEST_DATABASE_URL=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=atlas-development
TEMPORAL_TASK_QUEUE=atlas-development
ATLAS_BACKEND_PORT=4000
ATLAS_BACKEND_URL=http://localhost:4000
# Password for the seeded local admin account. This is only for local demo mode.
ATLAS_DEMO_ADMIN_PASSWORD=
# Customer-side ingest gateway. Compose runs one process per environment.
# Development publishes localhost:4300; production publishes localhost:4301.
ATLAS_INGEST_PORT=4300
ATLAS_INGEST_CALLER_TOKEN=
ATLAS_INGEST_BACKEND_TOKEN=
ATLAS_INGEST_WORKER_URL=http://localhost:4200
ATLAS_INGEST_RESPONSE_TIMEOUT_MS=60000
# Must match between the gateway and its environment worker.
ATLAS_WORKFLOW_RESULT_TOKEN=
# Comma-separated public hosts; empty denies every remote capability source.
CAPABILITY_SOURCE_ALLOWED_HOSTS=
# Burger Town is a separate app running locally on port 43123.
# Connect also looks for /arazzo.yaml next to openapi.json when present.
ATLAS_BURGER_TOWN_ALLOWED_HOSTS=host.docker.internal
ATLAS_BURGER_TOWN_ALLOWED_PRIVATE_HOSTS=host.docker.internal
ATLAS_BURGER_TOWN_APPLICATION_URLS=http://host.docker.internal:43123
ATLAS_BURGER_TOWN_OPENAPI_URLS=http://host.docker.internal:43123/openapi.json
# Optional real-model planning. For Compose, write the key to the ignored
# .local/openai-api-key file and set OPENAI_API_KEY_FILE=../../.local/openai-api-key.
# OPENAI_API_KEY remains available only when running the backend directly.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=./secrets/empty-openai-api-key
OPENAI_MODEL=
# Optional backend-only GitHub token for higher public API read limits.
# For Compose, set this to ../../.local/github-token after creating that local file.
GITHUB_TOKEN_FILE=./secrets/empty-github-token
# Optional sample-demo provider modes. The default for each is
# contract-faithful-rehearsal. official-test requires the matching test credential.
STRIPE_DEMO_MODE=contract-faithful-rehearsal
STRIPE_SECRET_KEY=
SLACK_DEMO_MODE=contract-faithful-rehearsal
SLACK_BOT_TOKEN=
HUBSPOT_DEMO_MODE=contract-faithful-rehearsal
HUBSPOT_ACCESS_TOKEN=
# Optional local-process membership credentials; configure the full role set together.
ATLAS_PLANNING_AUTHOR_TOKEN=
ATLAS_PLANNING_AUTHOR_ACTOR_ID=atlas-author
ATLAS_PLANNING_ORGANIZATION_ID=org_atlas
ATLAS_APPROVAL_ADMIN_TOKEN=
ATLAS_APPROVAL_ADMIN_ACTOR_ID=
ATLAS_REPAIR_OPERATOR_TOKEN=
ATLAS_REPAIR_OPERATOR_ACTOR_ID=
ATLAS_EXECUTION_ORGANIZATION_ID=org_atlas
# Canonical local Worker environment. The retired production-like value is stale and rejected.
ATLAS_EXECUTION_ENVIRONMENT_ID=production
ATLAS_WORKER_PORT=4200
# Disable the legacy direct intake listener in the one-box topology; the worker then only dials out.
ATLAS_WORKER_INTAKE_HTTP_ENABLED=true
VITE_ATLAS_BACKEND_URL=http://localhost:4000
MOCK_SERVICES_PORT=4100
MOCK_SERVICES_URL=http://localhost:4100
TEMPORAL_UI_URL=http://localhost:8080

# Required secret names. These placeholders are not credentials.
ATLAS_WORKER_TOKEN=
EXECUTION_GRANT_PRIVATE_KEY=
EXECUTION_GRANT_PUBLIC_KEY=
ATLAS_BUNDLE_SIGNING_KEY_ID=
ATLAS_BUNDLE_SIGNING_PRIVATE_KEY=
ATLAS_BUNDLE_TRUST_CONFIG={"keys":[]}
WORKER_SECRET_CONFIG_PATH=./.local/worker-secrets.json
TEMPORAL_PAYLOAD_ENCRYPTION_KEY_ALIAS=temporalPayloadEncryptionKey
RUN_COMMAND_ENCRYPTION_KEY_ALIAS=runCommandEncryptionKey
