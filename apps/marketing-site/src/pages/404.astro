---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page not found — Atlas';
const description = 'The requested Atlas page does not exist.';
---

<BaseLayout {title} {description} pathname="/404.html" noindex>
  <SiteHeader />
  <main id="main" class="not-found shell">
    <p class="eyebrow"><span aria-hidden="true"></span> 404 · Page not found</p>
    <h1>This path isn’t part of the workflow.</h1>
    <p>Start with the product overview, explore the workflow lifecycle, or find the resources for your evaluation.</p>
    <div class="not-found-actions">
      <a class="button" href="/">Atlas home <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/how-it-works/">How Atlas works</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
