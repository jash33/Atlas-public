---
import { docsUrl } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const checks = [
  ['Business outcome', 'Name the launch, migration, or maintenance problem. Record the delay, engineering time, or revenue at risk.'],
  ['System coverage', 'List APIs, fields, transformations, authentication, owners, and write operations. Confirm what Atlas can support.'],
  ['Expected behavior', 'Define the successful output and how retries, duplicate requests, and partial failures should behave.'],
  ['Failure rehearsal', 'Use test systems to simulate an outage, a worker restart, duplicate delivery, and a contract change.'],
  ['Operating responsibilities', 'Compare setup effort, recovery effort, and operating costs. Decide who will run and maintain the installation.'],
];
---
<BaseLayout title="Evaluate Atlas — Prove the fit on one workflow" description="A practical evaluation plan for Atlas: define the business outcome, check API coverage, rehearse failures, and measure the work before moving traffic." pathname="/evaluate/">
<SiteHeader current="evaluate" />
<main id="main">
<header class="page-hero narrow">
<p class="eyebrow">A clear path to a decision</p>
<h1>One workflow.<br />A decision you can defend.</h1>
<p class="lede">Start with the integration holding something important back. Define what success is worth, then test whether Atlas can deliver it.</p>
<div class="actions">
<a class="button" href="#evaluation-brief">Build your evaluation brief <span aria-hidden="true">↓</span>
</a>
<a class="button secondary" href="/how-it-works/#reference-workflow">See the example first</a>
</div>
</header>
<nav class="subnav narrow" aria-label="Evaluation sections">
<a href="#fit">Check the fit</a>
<a href="#checklist">Define the proof</a>
<a href="#evaluation-brief">Create a brief</a>
<a href="#availability">What's available</a>
</nav>
<section class="section narrow" id="fit">
<header class="section-heading">
<div>
<p class="eyebrow">01 / Choose a useful starting point</p>
<h2>Find the work<br />worth proving.</h2>
</div>
<p>A contained workflow with a real owner and a measurable outcome gives you a better decision than a broad platform trial.</p>
</header>
<div class="fit-grid">
<article>
<p class="eyebrow">A strong evaluation candidate</p>
<h3>Known systems.<br />A costly bottleneck.</h3>
<ul>
<li>An integration is delaying a customer launch.</li>
<li>A migration depends on understanding existing API workflows.</li>
<li>Repeated API changes create expensive maintenance work.</li>
<li>Your team has test APIs, sample data, and time to review the results.</li>
</ul>
</article>
<article>
<p class="eyebrow">Check these requirements early</p>
<h3>Make the boundaries<br />part of the decision.</h3>
<ul>
<li>Required APIs and authentication must be supported.</li>
<li>Dependency analysis covers contracts and workflows known to Atlas.</li>
<li>A complete customer runtime installer is still in development.</li>
<li>Company-wide discovery and general agent context access are future direction.</li>
</ul>
</article>
</div>
</section>
<section class="section platform-section" id="checklist">
<div class="narrow split-section">
<div>
<p class="eyebrow">02 / Agree what good looks like</p>
<h2>Test the hard parts.<br />Measure what matters.</h2>
<p>Use the same workflow and test cases when comparing Atlas with your current tools. Put engineering hours, recovery time, infrastructure, and ongoing ownership on the same page.</p>
<a class="text-link" href="/compare/">Compare approaches <span aria-hidden="true">↗</span>
</a>
</div>
<ul class="checklist">{checks.map(([heading,body],index)=>
<li>
<label>
<input type="checkbox" name="evaluation-check" value={heading} />
<span>
<strong>{String(index+1).padStart(2,'0')} / {heading}</strong>
<span class="check-detail">{body}</span>
</span>
</label>
</li>)}</ul>
</div>
</section>
<section class="section narrow split-section" id="evaluation-brief">
<div>
<p class="eyebrow">03 / Bring the right questions</p>
<h2>Turn the idea<br />into a brief.</h2>
<p>Use this outline to record what you want to test. Download it to carry the same success criteria into the evaluation and plan the next step.</p>
<p class="term">Your entries stay in this page until you download them. Nothing is submitted to a server.</p>
</div>
<form class="evaluation-form" id="brief-form">
<label for="brief-outcome">What is this workflow holding back?<textarea id="brief-outcome" name="outcome" placeholder="A customer launch, a migration deadline, repeated manual recovery…" required>
</textarea>
</label>
<label for="brief-systems">Which systems and people are involved?<textarea id="brief-systems" name="systems" placeholder="APIs, important fields, write operations, service owners, decision makers…">
</textarea>
</label>
<label for="brief-success">What would make the evaluation a success?<textarea id="brief-success" name="success" placeholder="Expected behavior, failure tests, time saved, cost limits, deadline…">
</textarea>
</label>
<div class="actions">
<button class="button" type="submit">Create evaluation brief <span aria-hidden="true">↗</span>
</button>
</div>
<p class="copy-status" id="brief-status" role="status">A plain-text brief you can edit and share with your team.</p>
<div id="brief-result" hidden>
<label for="brief-output">Your evaluation brief<textarea id="brief-output" readonly rows="14">
</textarea>
</label>
<a class="button secondary" id="brief-download" download="atlas-evaluation-brief.txt" style="margin-top:20px">Download .txt <span aria-hidden="true">↓</span>
</a>
</div>
</form>
</section>
<section class="section narrow reference" id="availability">
<header class="section-heading">
<div>
<p class="eyebrow">04 / Know what you're evaluating</p>
<h2>Current capability.<br />Clear next steps.</h2>
</div>
</header>
<div class="availability">
<article>
<h3>Workflow evaluation</h3>
<p>The developer setup supports approved API operations, workflow drafting and checks, human approval, Temporal execution, and review of rediscovered contract changes. Start from the <a href="https://github.com/jash33/Atlas-public">project repository</a>.</p>
<a class="text-link" href={docsUrl('/self-host/#try-the-current-local-build')}>Read the developer setup <span aria-hidden="true">↗</span>
</a>
</article>
<article>
<h3>Customer web & company sign-in</h3>
<p>A separate package provides the Console, backend, database, and company sign-in. It supports one identity provider per installation. This package does not include the full customer workflow runtime.</p>
<a class="text-link" href={docsUrl('/sso-installation/')}>Review company sign-in setup <span aria-hidden="true">↗</span>
</a>
</article>
</div>
<p class="term" style="margin-top:35px">Atlas is a personal project in development. Review operating costs and production requirements before using it for live traffic.</p>
</section>
<section class="closing">
<p class="eyebrow">Evidence before commitment</p>
<h2>See the full lifecycle.<br />Then choose your first workflow.</h2>
<a class="button" href="/how-it-works/">See how Atlas works <span aria-hidden="true">↗</span>
</a>
</section>
</main>
<SiteFooter />
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#brief-form');
  let downloadUrl: string | undefined;
  form?.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(form);
    const checklist = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="evaluation-check"]')).map(input => (input.checked ? '[x] ' : '[ ] ') + input.value);
    const content = ['ATLAS — WORKFLOW EVALUATION BRIEF', '', 'Business outcome', String(data.get('outcome') ?? ''), '', 'Systems and people', String(data.get('systems') ?? ''), '', 'Success criteria', String(data.get('success') ?? ''), '', 'Preparation checklist', checklist.join('\n'), '', 'Before moving traffic', '- Confirm API and authentication coverage.', '- Rehearse duplicate delivery, outage, restart, and contract change.', '- Agree costs, ownership, support, cutover, and rollback.', '', 'Atlas is a developer preview. Full customer workflow-runtime packaging is still in development.'].join('\n');
    if (downloadUrl) URL.revokeObjectURL(downloadUrl);
    downloadUrl = URL.createObjectURL(new Blob([content], { type: 'text/plain;charset=utf-8' }));
    const output = document.querySelector<HTMLTextAreaElement>('#brief-output');
    const result = document.querySelector<HTMLElement>('#brief-result');
    const link = document.querySelector<HTMLAnchorElement>('#brief-download');
    if (output) output.value = content;
    if (link) link.href = downloadUrl;
    if (result) result.hidden = false;
    const status = document.querySelector('#brief-status');
    if (status) status.textContent = 'Your brief is ready below. Download it or copy the text.';
  });
</script>
