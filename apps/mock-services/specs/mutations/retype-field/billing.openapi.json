{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas Mock Billing API",
    "version": "1.0.0"
  },
  "paths": {
    "/invoices/{invoiceId}": {
      "get": {
        "operationId": "getInvoice",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoiceId}/settlement": {
      "post": {
        "operationId": "beginInvoiceSettlement",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceMutation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelInvoiceSettlement",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceMutation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoiceId}/payment": {
      "post": {
        "operationId": "markInvoicePaid",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceMutation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      }
    },
    "/mapping-demo/billing/settlements": {
      "post": {
        "operationId": "settleMappingDemoInvoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MappingDemoBillingSettlement"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Settlement accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MappingDemoBillingAccepted"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Invoice": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "settling",
              "paid"
            ]
          },
          "outstandingBalance": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              }
            },
            "required": [
              "value",
              "currency"
            ],
            "additionalProperties": false
          },
          "customerId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "invoiceId",
          "status",
          "outstandingBalance",
          "customerId",
          "version"
        ],
        "additionalProperties": false
      },
      "InvoiceMutation": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "minLength": 1
          },
          "expectedInvoiceVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "paymentId",
          "expectedInvoiceVersion",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "MappingDemoBillingSettlement": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "minLength": 1
          },
          "payment": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "x-atlas-unit": "decimal-currency"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "x-atlas-case": "upper"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "notification": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "address"
            ],
            "additionalProperties": false
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "invoiceId",
          "payment",
          "notification"
        ],
        "additionalProperties": false
      },
      "MappingDemoBillingAccepted": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      }
    }
  }
}
