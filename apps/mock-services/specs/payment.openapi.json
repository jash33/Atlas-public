{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas Mock Payment API",
    "version": "1.0.0"
  },
  "paths": {
    "/payments/{paymentId}": {
      "get": {
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "x-atlas-data-classification": "internal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    },
    "/mapping-demo/payments/{paymentId}": {
      "get": {
        "operationId": "getMappingDemoPayment",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "x-atlas-data-classification": "internal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MappingDemoPayment"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Payment": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "minLength": 1
          },
          "invoiceId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "amount": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              }
            },
            "required": [
              "value",
              "currency"
            ],
            "additionalProperties": false
          },
          "paidAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "paymentId",
          "invoiceId",
          "status",
          "amount",
          "paidAt"
        ],
        "additionalProperties": false
      },
      "MappingDemoPayment": {
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "string",
            "minLength": 1
          },
          "invoice_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-atlas-unit": "cents"
          },
          "currency": {
            "type": "string",
            "pattern": "^[a-z]{3}$",
            "x-atlas-case": "lower"
          },
          "customer": {
            "type": "object",
            "properties": {
              "notification_email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "notification_email"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payment_id",
          "invoice_id",
          "amount_cents",
          "currency",
          "customer"
        ],
        "additionalProperties": false
      }
    }
  }
}
