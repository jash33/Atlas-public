# Fill these in before running Compose. Keep the copied .env private.
ATLAS_PUBLIC_ORIGIN=https://atlas.customer.example
ATLAS_ORGANIZATION_NAME=Customer name
ATLAS_SSO_ORGANIZATION_ID=customer-organization-id
# Generate 32 random bytes as hex; the same password is used by Postgres and Atlas.
ATLAS_DATABASE_PASSWORD=

# Select exactly one provider: entra, google, or okta.
ATLAS_SSO_PROVIDER=entra
ATLAS_SSO_TENANT_ID=
# For Google, remove ATLAS_SSO_TENANT_ID and use:
# ATLAS_SSO_GOOGLE_DOMAIN=customer.example
# For Okta, remove ATLAS_SSO_TENANT_ID and use:
# ATLAS_SSO_OKTA_ISSUER=https://customer.okta.com
ATLAS_SSO_CLIENT_ID=
ATLAS_SSO_CLIENT_SECRET=
# Alternatively remove CLIENT_SECRET and put a secret file in .local/secrets:
# ATLAS_SSO_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
ATLAS_SESSION_MAX_AGE_SECONDS=28800
# Atlas roles are assigned to verified individual accounts in Settings > Access requests.
# Use provider-side app assignment for directory groups; Atlas does not import group roles.

# For published releases, use the supplied image names and immutable digests.
# ATLAS_BACKEND_IMAGE=registry.example/atlas-backend@sha256:...
# ATLAS_CONSOLE_IMAGE=registry.example/atlas-console@sha256:...
